<?xml version="1.0"?>
<?xml-model
   href="http://download.ros.org/schema/package_format3.xsd"
   schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>can_motor_controller</name>
  <version>0.1.0</version>
  <description>Simulated CAN bus bridge for a diff-drive robot: converts /cmd_vel to CAN motor commands and publishes /odom from simulated encoder feedback.</description>
  <maintainer email="shivani.hema12@gmail.com">shiva</maintainer>
  <license>Apache License 2.0</license>

  <depend>rclrs</depend>
  <depend>rosidl_runtime_rs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
